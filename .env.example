# ============ personal health assistant - env template ============
# copy to .env and fill real values. .env is gitignored, never committed.
# ---- app ----
APP_HOST=0.0.0.0
APP_PORT=8020
LOG_LEVEL=INFO

# ---- LLM provider chain: primary -> fallback (official DeepSeek, same key) ----
BASE_URL_DEEPSEEK=https://api.deepseek.com
API_KEY_DEEPSEEK=<fill>
MODEL_DEEPSEEK=deepseek-v4-pro
MODEL_DEEPSEEK_FALLBACK=deepseek-flash

# ---- reserved third-party provider (Kimi etc.; enabled when filled) ----
BASE_URL_KIMI=
API_KEY_KIMI=
MODEL_KIMI=

# ---- PostgreSQL + pgvector ----
PG_HOST=localhost
PG_PORT=5434
PG_USER=health
PG_PASSWORD=<fill>
PG_DB=health_assistant

# ---- Redis (enabled at V4) ----
REDIS_URL=redis://localhost:6381/0

# ---- security ----
JWT_SECRET=<fill>
MCP_SHARED_KEY=<fill>

# ---- timeouts / retry (aligned) ----
MCP_TIMEOUT_SECONDS=5
MCP_HEALTH_URL=http://localhost:8020/mcp/health
LLM_RETRY_TIMES=3

# ---- embedding (enabled at P9) ----
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3

# ---- demo account (P4 replaced by users table + bcrypt) ----
DEMO_USERNAME=health-demo
DEMO_PASSWORD=health-demo
